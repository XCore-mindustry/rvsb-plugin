{
  unit.dp-initiative-unit:
  {
    region: dp-initiative
    outlineRegion: clear
    cellRegion: dp-initiative-cell
    shadowRegion: clear
    wreckRegions:
    [
      clear
    ]
    fullIcon: dp-initiative-full-icon
    uiIcon: dp-initiative-ui-icon
    previewRegion: omura
    weapons.0.region: clear
    weapons.0.heatRegion: clear
    weapons.0.cellRegion: clear
    weapons.0.outlineRegion: clear
    weapons.1.region: clear
    weapons.1.heatRegion: clear
    weapons.1.cellRegion: clear
    weapons.1.outlineRegion: clear
    weapons.2.region: clear
    weapons.2.heatRegion: clear
    weapons.2.cellRegion: clear
    weapons.2.outlineRegion: clear
    weapons.3.region: clear
    weapons.3.heatRegion: clear
    weapons.3.cellRegion: clear
    weapons.3.outlineRegion: clear
  }
  status.dp-initiative-oc:
  {
    fullIcon: clear
    uiIcon: clear
  }
  status.dp-pierced:
  {
    fullIcon: dp-pierced-icon
    uiIcon: dp-pierced-icon
  }
}
